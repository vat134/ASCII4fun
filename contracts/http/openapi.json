  "components": {
    "schemas": {
      "AnimationConversionRequest": {
        "required": ["options", "playback"],
        "type": "object",
        "properties": {
          "options": {
            "type": "object",
            "properties": {
              "outputWidthInCells": {
                "pattern": "^-?(?:0|[1-9]\\d*)$",
                "type": ["integer", "string"],
                "description": "The requested output width measured in character cells.",
                "format": "int32"
              },
              "characterRamp": {
                "type": "string",
                "description": "The well-formed Unicode glyph ramp ordered from darkest to lightest."
              },
              "useMeasuredGlyphDensity": {
                "type": "boolean",
                "description": "Selects nearest measured glyph coverage instead of equally spaced ramp positions. Defaults to false."
              },
              "invert": {
                "type": "boolean",
                "description": "Reverses light and dark glyph mapping."
              },
              "sourceColors": {
                "type": "boolean",
                "description": "Uses sampled source colors, composited over white like luminance analysis."
              },
              "contrast": {
                "pattern": "^-?(?:0|[1-9]\\d*)$",
                "type": ["integer", "string"],
                "description": "Contrast around the midpoint; -100 flattens, 0 preserves, +100 increases contrast.",
                "format": "int32"
              },
              "brightness": {
                "pattern": "^-?(?:0|[1-9]\\d*)$",
                "type": ["integer", "string"],
                "description": "Additive brightness in percentage points; 0 preserves the input.",
                "format": "int32"
              },
              "shadowLift": {
                "pattern": "^-?(?:0|[1-9]\\d*)$",
                "type": ["integer", "string"],
                "description": "Lifts shadows with an endpoint-preserving power curve before contrast/brightness; 0 disables, 100 uses exponent 1/3.",
                "format": "int32"
              },
              "sourcePhotoOpacity": {
                "pattern": "^-?(?:0|[1-9]\\d*)$",
                "type": ["integer", "string"],
                "description": "Opacity of the normalized original photo beneath glyphs, in percent (0..100); 0 retains no photo.",
                "format": "int32"
              },
              "monochromeColor": {
                "type": "object",
                "properties": {
                  "red": {
                    "pattern": "^-?(?:0|[1-9]\\d*)$",
                    "type": ["integer", "string"],
                    "description": "Red channel.",
                    "format": "uint8"
                  },
                  "green": {
                    "pattern": "^-?(?:0|[1-9]\\d*)$",
                    "type": ["integer", "string"],
                    "description": "Green channel.",
                    "format": "uint8"
                  },
                  "blue": {
                    "pattern": "^-?(?:0|[1-9]\\d*)$",
                    "type": ["integer", "string"],
                    "description": "Blue channel.",
                    "format": "uint8"
                  }
                },
                "description": "An opaque color with 8-bit sRGB channels."
              },
              "backgroundColor": {
                "type": "object",
                "properties": {
                  "red": {
                    "pattern": "^-?(?:0|[1-9]\\d*)$",
                    "type": ["integer", "string"],
                    "description": "Red channel.",
                    "format": "uint8"
                  },
                  "green": {
                    "pattern": "^-?(?:0|[1-9]\\d*)$",
                    "type": ["integer", "string"],
                    "description": "Green channel.",
                    "format": "uint8"
                  },
                  "blue": {
                    "pattern": "^-?(?:0|[1-9]\\d*)$",
                    "type": ["integer", "string"],
                    "description": "Blue channel.",
                    "format": "uint8"
                  }
                },
                "description": "An opaque color with 8-bit sRGB channels."
              }
            },
            "description": "Controls glyph-based conversion of a still image."
          },
          "playback": {
            "type": "object",
            "properties": {
              "speed": {
                "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
                "type": ["number", "string"],
                "description": "Playback rate from 0.25 to 4; 2 plays twice as fast.",
                "format": "double"
              },
              "framesPerSecond": {
                "pattern": "^-?(?:0|[1-9]\\d*)$",
                "type": ["null", "integer", "string"],
                "description": "Optional uniform cadence: 1..50 FPS for GIF, 1..60 for video; capped by the source average before speed.",
                "format": "int32"
              }
            },
            "description": "Shared preview/export timing. Omitted FPS preserves the source frame sequence."
          }
        }
      },
      "ExportError": {
        "required": ["message", "type"],
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "type": { "enum": ["error"], "type": "string" }
        }
      },
      "ExportProgress": {
        "required": ["completedFrames", "type"],
        "type": "object",
        "properties": {
          "completedFrames": { "type": "integer", "format": "int32" },
          "type": { "enum": ["progress"], "type": "string" }
        }
      },
      "FigletFontInfo": {
        "required": ["id", "name", "category", "hasNativeColors", "note"],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The stable identifier passed to AsciiCanvas FigletConverter.Convert(string text, string fontId, RgbColor? foregroundColor = null, IReadOnlyDictionary&lt;RgbColor, RgbColor&gt;? colorReplacements = null, CancellationToken cancellationToken = default(CancellationToken))."
          },
          "name": {
            "type": "string",
            "description": "The font's display name."
          },
          "category": {
            "type": "string",
            "description": "The display category for font browsing and filtering."
          },
          "hasNativeColors": {
            "type": "boolean",
            "description": "Whether the default artwork carries authored foreground and background colors.",
            "default": false
          },
          "note": {
            "type": ["null", "string"],
            "description": "Font-specific coverage or display guidance."
          }
        },
        "description": "A bundled FIGfont available to the shared text converter."
      },
      "GifExportComplete": {
        "required": ["gif", "type"],
        "type": "object",
        "properties": {
          "gif": { "type": "string", "format": "byte" },
          "type": { "enum": ["complete"], "type": "string" }
        }
      },
      "IFormFile": { "type": "string", "format": "binary" },
      "ImageConfiguration": {
        "required": [
          "defaultOutputWidthInCells",
          "minOutputWidthInCells",
          "maxOutputWidthInCells",
          "defaultCharacterRamp",
          "defaultCharacterCellAspectRatio",
          "maxEncodedBytes",
          "minToneAdjustment",
          "maxToneAdjustment",
          "defaultMonochromeColor",
          "defaultBackgroundColor",
          "maxPercentage",
          "requestToken"
        ],
        "type": "object",
        "properties": {
          "defaultOutputWidthInCells": { "type": "integer", "format": "int32" },
          "minOutputWidthInCells": { "type": "integer", "format": "int32" },
          "maxOutputWidthInCells": { "type": "integer", "format": "int32" },
          "defaultCharacterRamp": { "type": "string" },
          "defaultCharacterCellAspectRatio": {
            "type": "number",
            "format": "double"
          },
          "maxEncodedBytes": { "type": "integer", "format": "int64" },
          "minToneAdjustment": { "type": "integer", "format": "int32" },
          "maxToneAdjustment": { "type": "integer", "format": "int32" },
          "defaultMonochromeColor": { "$ref": "#/components/schemas/RgbColor" },
          "defaultBackgroundColor": { "$ref": "#/components/schemas/RgbColor" },
          "maxPercentage": { "type": "integer", "format": "int32" },
          "requestToken": { "type": "string" }
        }
      },
      "ImageConversionResponse": {
        "required": ["text", "widthInCells", "heightInCells", "png"],
        "type": "object",
        "properties": {
          "text": { "type": "string" },
          "widthInCells": { "type": "integer", "format": "int32" },
          "heightInCells": { "type": "integer", "format": "int32" },
          "png": { "type": "string", "format": "byte" }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": { "type": ["null", "string"] },
          "title": { "type": ["null", "string"] },
          "status": { "type": ["null", "integer"], "format": "int32" },
          "detail": { "type": ["null", "string"] },
          "instance": { "type": ["null", "string"] }
        }
      },
      "RgbColor": {
        "required": ["red", "green", "blue"],
        "type": "object",
        "properties": {
          "red": {
            "type": "integer",
            "description": "Red channel.",
            "format": "uint8"
          },
          "green": {
            "type": "integer",
            "description": "Green channel.",
            "format": "uint8"
          },
          "blue": {
            "type": "integer",
            "description": "Blue channel.",
            "format": "uint8"
          }
        },
        "description": "An opaque color with 8-bit sRGB channels."
      },
      "TextConversionRequest": {
        "required": ["text"],
        "type": "object",
        "properties": {
          "text": { "type": ["null", "string"] },
          "fontId": { "type": "string", "default": "standard" },
          "format": { "type": "string", "default": "json" },
          "foregroundColor": { "type": ["null", "string"] },
          "colorReplacements": {
            "type": ["null", "object"],
            "additionalProperties": { "type": "string" }
          }
        }
      },
      "VideoExportComplete": {
        "required": ["video", "type"],
        "type": "object",
        "properties": {
          "video": { "type": "string", "format": "byte" },
          "type": { "enum": ["complete"], "type": "string" }
        }
      },
      "VideoMetadata": {
        "required": [
          "widthInPixels",
          "heightInPixels",
          "durationMs",
          "framesPerSecond",
          "hasAudio",
          "frameCount"
        ],
        "type": "object",
        "properties": {
          "widthInPixels": {
            "type": "integer",
            "description": "Frame width after orientation and sample-aspect normalization.",
            "format": "int32"
          },
          "heightInPixels": {
            "type": "integer",
            "description": "Frame height after orientation and sample-aspect normalization.",
            "format": "int32"
          },
          "durationMs": {
            "type": "number",
            "description": "Source duration in milliseconds.",
            "format": "double"
          },
          "framesPerSecond": {
            "type": "number",
            "description": "Average source frame rate.",
            "format": "double"
          },
          "hasAudio": {
            "type": "boolean",
            "description": "Whether a source audio track exists."
          },
          "frameCount": {
            "type": "integer",
            "description": "Decoded source frame count.",
            "format": "int32"
          }
        },
        "description": "Validated source video information, before playback retiming."
      }
    }
  },
  "tags": [
    { "name": "Ascii4Fun.Server" },
    { "name": "ImageConversionEndpoints" },
    { "name": "TextConversionEndpoints" },
    { "name": "AnimationConversionEndpoints" },
    { "name": "VideoConversionEndpoints" }
  ]
}
