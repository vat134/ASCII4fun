{
  "openapi": "3.1.1",
  "info": {
    "title": "ASCII4fun HTTP API",
    "description": "Transient local-first conversion. Generated from C# models and endpoint metadata.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/images/options": {
      "get": {
        "tags": ["Ascii4Fun.Server"],
        "operationId": "GetImageOptions",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ImageConfiguration" }
              }
            }
          }
        }
      }
    },
    "/api/images/convert": {
      "post": {
        "tags": ["ImageConversionEndpoints"],
        "operationId": "ConvertImage",
        "parameters": [
          {
            "name": "X-CSRF-TOKEN",
            "in": "header",
            "description": "Use requestToken from GET /api/images/options and retain that response's antiforgery cookie.",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "image",
                  "outputWidthInCells",
                  "characterRamp",
                  "invert"
                ],
                "type": "object",
                "allOf": [
                  {
                    "type": "object",
                    "properties": {
                      "image": { "$ref": "#/components/schemas/IFormFile" }
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "outputWidthInCells": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": ["integer", "string"],
                        "format": "int32"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "properties": { "characterRamp": { "type": "string" } }
                  },
                  {
                    "type": "object",
                    "properties": { "invert": { "type": "boolean" } }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "sourceColors": { "type": "boolean", "default": false }
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "contrast": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": ["integer", "string"],
                        "format": "int32",
                        "default": 0
                      }
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "brightness": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": ["integer", "string"],
                        "format": "int32",
                        "default": 0
                      }
                    }
                  },
                  {
                    "type": "object",
                    "properties": { "monochromeColor": { "type": "string" } }
                  },
                  {
                    "type": "object",
                    "properties": { "backgroundColor": { "type": "string" } }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "shadowLift": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": ["integer", "string"],
                        "format": "int32",
                        "default": 0
                      }
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "sourcePhotoOpacity": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": ["integer", "string"],
                        "format": "int32",
                        "default": 0
                      }
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "useMeasuredGlyphDensity": {
                        "type": "boolean",
                        "default": false
                      }
                    }
                  }
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImageConversionResponse"
                }
              }
            }
          },
          "400": {
            "description": "HTTP 400. Application errors use Problem Details; framework/transport failures may have an empty body.",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "413": {
            "description": "HTTP 413. Application errors use Problem Details; framework/transport failures may have an empty body.",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "415": {
            "description": "HTTP 415. Application errors use Problem Details; framework/transport failures may have an empty body.",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "422": {
            "description": "HTTP 422. Application errors use Problem Details; framework/transport failures may have an empty body.",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "429": {
            "description": "HTTP 429. Application errors use Problem Details; framework/transport failures may have an empty body.",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "500": {
            "description": "HTTP 500. Application errors use Problem Details; framework/transport failures may have an empty body.",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "504": {
            "description": "Request timeout. The response may have no body."
          }
        }
      }
    },
