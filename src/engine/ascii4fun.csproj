<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Ascii4Fun</RootNamespace>
    <AssemblyName>Ascii4Fun</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>Ascii4Fun</PackageId>
    <Description>Reusable image, animation, and text to ASCII conversion engine.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-AnyCPU" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ascii4Fun.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="rendering/fonts/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
             Pack="true" PackagePath="contentFiles/any/net10.0/rendering/fonts/" PackageCopyToOutput="true" />
  </ItemGroup>

</Project>
