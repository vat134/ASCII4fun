<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <AssemblyName>Ascii4Fun.Browser</AssemblyName>
    <RootNamespace>Ascii4Fun.Browser</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WasmMainJSPath>main.js</WasmMainJSPath>
    <WasmEnableHotReload>false</WasmEnableHotReload>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="notices/*" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Magick.NET.Core" GeneratePathProperty="true" />
    <Compile Include="../images/*.cs" Exclude="../images/still-image-converter.cs" LinkBase="images" />
    <Compile Include="../animations/animation-*.cs" LinkBase="animations" />
    <Compile Include="../videos/video-timeline.cs" LinkBase="videos" />
    <Compile Include="../figlet/*.cs" LinkBase="figlet" />
    <EmbeddedResource Include="../figlet/fonts/*.flf" LogicalName="Ascii4Fun.Figlet.Fonts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../figlet/fonts/*.tdf" LogicalName="Ascii4Fun.Figlet.Fonts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../figlet/fonts/selected-assets.json" LogicalName="Ascii4Fun.Figlet.Fonts.selected-assets.json" />
    <EmbeddedResource Include="../figlet/fonts/*.txt" LogicalName="Ascii4Fun.Figlet.Fonts.%(Filename)%(Extension)" />
    <Compile Include="../media/*.cs" Exclude="../media/magick-still-image-reader.cs;../media/magick-gif-reader.cs;../media/magick-color-normalizer.cs" LinkBase="media" />
    <Compile Include="../rendering/*.cs" Exclude="../rendering/png-exporter.cs;../rendering/magick-glyph-renderer.cs" LinkBase="rendering" />
  </ItemGroup>
  <Target Name="CopyBrowserRuntimeNotices" AfterTargets="Publish">
    <Copy SourceFiles="$(PkgMagick_NET_Core)/Copyright.txt" DestinationFiles="$(PublishDir)notices/magick-core-notices.txt" />
  </Target>
</Project>
